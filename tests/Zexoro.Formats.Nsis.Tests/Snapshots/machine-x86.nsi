; Generated by zexoro. Do not edit: 'zexoro pack' writes it again from zexoro.toml.
Unicode true
ManifestDPIAware true
SetCompressor /SOLID lzma
RequestExecutionLevel admin

!define ZX_REGROOT HKLM
!define ZX_UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\com.example.notes"
!define ZX_VERSION_ORDER "0000100002000032"
!define ZX_MAIN "$INSTDIR\app\ExampleNotes.exe"
!define ZX_MAIN_DIR "$INSTDIR\app"

Name "Example Notes"
OutFile "package.exe"
InstallDir "$PROGRAMFILES\Example Notes"
BrandingText "Example Notes 1.2.3"

!include MUI2.nsh
!include LogicLib.nsh
!include x64.nsh

!define MUI_ICON "icon.ico"
!define MUI_UNICON "icon.ico"
!define MUI_ABORTWARNING
!insertmacro MUI_PAGE_INSTFILES
!define MUI_FINISHPAGE_RUN
!define MUI_FINISHPAGE_RUN_FUNCTION zxLaunch
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

; No LegalCopyright: zexoro has no copyright notice to put there.
!pragma warning disable 9100
VIProductVersion "1.2.3.0"
VIFileVersion "1.2.3.0"
VIAddVersionKey /LANG=${LANG_ENGLISH} "ProductName" "Example Notes"
VIAddVersionKey /LANG=${LANG_ENGLISH} "ProductVersion" "1.2.3"
VIAddVersionKey /LANG=${LANG_ENGLISH} "CompanyName" "Example Ltd."
VIAddVersionKey /LANG=${LANG_ENGLISH} "FileDescription" "Example Notes installer"
VIAddVersionKey /LANG=${LANG_ENGLISH} "FileVersion" "1.2.3"

; Refuses to continue while the main executable is running: a running image cannot be opened for writing.
!macro ZX_CHECK_NOT_RUNNING UN
Function ${UN}zxCheckNotRunning
  retry:
  ${If} ${FileExists} "${ZX_MAIN}"
    ClearErrors
    FileOpen $0 "${ZX_MAIN}" a
    ${If} ${Errors}
      MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "Example Notes is running. Close it, then select Retry." /SD IDCANCEL IDRETRY retry
      SetErrorLevel 4
      Quit
    ${EndIf}
    FileClose $0
  ${EndIf}
FunctionEnd
!macroend
!insertmacro ZX_CHECK_NOT_RUNNING ""
!insertmacro ZX_CHECK_NOT_RUNNING "un."

Function .onInit
  SetShellVarContext all
  UserInfo::GetAccountType
  Pop $0
  ${If} $0 != "admin"
    MessageBox MB_OK|MB_ICONSTOP "Example Notes is installed for all users, which requires administrator rights." /SD IDOK
    Abort
  ${EndIf}
  ; An existing install is upgraded in place, wherever it is.
  ReadRegStr $0 ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "InstallLocation"
  ${If} $0 != ""
    StrCpy $INSTDIR $0
    ReadRegStr $1 ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "ZexoroVersionOrder"
    ${If} $1 != ""
      StrCpy $2 "${ZX_VERSION_ORDER}"
      System::Call 'kernel32::CompareStringOrdinal(w r1, i -1, w r2, i -1, i 0) i .r3'
      ${If} $3 = 3
        ReadRegStr $4 ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "DisplayVersion"
        MessageBox MB_OK|MB_ICONSTOP "Example Notes $4 is already installed, which is newer than this version (1.2.3). Uninstall it first to install an older version." /SD IDOK
        SetErrorLevel 3
        Quit
      ${EndIf}
    ${EndIf}
  ${EndIf}
FunctionEnd

Function un.onInit
  SetShellVarContext all
  UserInfo::GetAccountType
  Pop $0
  ${If} $0 != "admin"
    MessageBox MB_OK|MB_ICONSTOP "Example Notes is installed for all users, which requires administrator rights." /SD IDOK
    Abort
  ${EndIf}
FunctionEnd

; Moves the previous version aside and deletes it, so no stale files remain.
Function zxRemoveApp
  RMDir /r "$INSTDIR\app.old"
  ${If} ${FileExists} "$INSTDIR\app\*.*"
    retry:
    ClearErrors
    Rename "$INSTDIR\app" "$INSTDIR\app.old"
    ${If} ${Errors}
      MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "Files in $INSTDIR\app are in use. Close Example Notes, then select Retry." /SD IDCANCEL IDRETRY retry
      SetErrorLevel 4
      Quit
    ${EndIf}
    RMDir /r "$INSTDIR\app.old"
  ${EndIf}
FunctionEnd

Function zxLaunch
  SetOutPath "${ZX_MAIN_DIR}"
  ; The installer runs elevated; Explorer starts the application as the signed-in user.
  Exec '"$WINDIR\explorer.exe" "${ZX_MAIN}"'
FunctionEnd

Section "-Install"
  Call zxCheckNotRunning
  Call zxRemoveApp
  SetOutPath "$INSTDIR\app"
  File /r "app\*"
  SetOutPath "$INSTDIR"
  File "zexoro-install.json"
  WriteUninstaller "$INSTDIR\uninstall.exe"
  ; Shortcuts of a previous version are replaced by the configured ones.
  Delete "$SMPROGRAMS\Example Notes.lnk"
  Delete "$DESKTOP\Example Notes.lnk"
  SetOutPath "${ZX_MAIN_DIR}"
  CreateShortcut "$DESKTOP\Example Notes.lnk" "${ZX_MAIN}"
  SetOutPath "$INSTDIR"
  WriteRegStr ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "DisplayName" "Example Notes"
  WriteRegStr ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "DisplayVersion" "1.2.3"
  WriteRegStr ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "Publisher" "Example Ltd."
  WriteRegStr ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\uninstall.exe,0"
  WriteRegStr ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "UninstallString" "$\"$INSTDIR\uninstall.exe$\""
  WriteRegStr ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "QuietUninstallString" "$\"$INSTDIR\uninstall.exe$\" /S"
  WriteRegStr ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "ZexoroVersionOrder" "${ZX_VERSION_ORDER}"
  WriteRegDWORD ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "NoRepair" 1
  WriteRegDWORD ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}" "EstimatedSize" 1234
SectionEnd

Section "Uninstall"
  Call un.zxCheckNotRunning
  Delete "$SMPROGRAMS\Example Notes.lnk"
  Delete "$DESKTOP\Example Notes.lnk"
  ; Only what the installer and the updater create is removed; the root itself only when it is empty.
  RMDir /r "$INSTDIR\app"
  RMDir /r "$INSTDIR\app.old"
  RMDir /r "$INSTDIR\app.new"
  Delete "$INSTDIR\zexoro-install.json"
  Delete "$INSTDIR\zexoro-install.json.new"
  Delete "$INSTDIR\zexoro-install.json.old"
  Delete "$INSTDIR\zexoro-updater.exe"
  Delete "$INSTDIR\zexoro-updater.exe.new"
  Delete "$INSTDIR\zexoro-updater.exe.old"
  Delete "$INSTDIR\uninstall.exe"
  Delete "$INSTDIR\uninstall.exe.new"
  Delete "$INSTDIR\uninstall.exe.old"
  RMDir "$INSTDIR"
  DeleteRegKey ${ZX_REGROOT} "${ZX_UNINSTALL_KEY}"
  ; The updater's state (accepted feed sequences, downloads) lives per user, for both scopes.
  SetShellVarContext current
  RMDir /r "$LOCALAPPDATA\zexoro\updater\com.example.notes"
  RMDir "$LOCALAPPDATA\zexoro\updater"
  RMDir "$LOCALAPPDATA\zexoro"
  SetShellVarContext all
SectionEnd
