<Project>
  <!--
    Embeds zexoro-updater for every runtime identifier it is built for into the CLI
    (docs/design/0005-nsis-updates.md section 3, docs/design/0006-desktop-formats.md section 2).
    Native AOT cannot cross-compile between operating systems, so the 'updater' job in ci.yml and
    release.yml publishes each one on a runner of its own system and every CLI build embeds the same
    files: it always ships updaters built from its own commit, and a package for any target can be
    built on any host.

    Properties:
      ZexoroUpdaterDir       a directory with zexoro-updater-<rid>.exe for win-x86, win-x64 and win-arm64
                             and zexoro-updater-<rid> for linux-x64, linux-arm64, linux-musl-x64,
                             linux-musl-arm64, osx-x64 and osx-arm64 (and optionally SHA256SUMS, which
                             they must then match); relative to the directory the build was started in
      ZexoroUpdaterRequired  true to fail the build when ZexoroUpdaterDir is not set (release builds)

    Without ZexoroUpdaterDir the CLI builds without updaters: tests never need one, and at run time
    ZEXORO_UPDATER_DIR points zexoro at a directory of updaters instead.

    Each updater is embedded gzip-compressed (resource Zexoro.Updater.<rid>.gz, about 45 % of the
    file) with the SHA-256 of the uncompressed file as assembly metadata Zexoro.Updater.<rid>.Sha256;
    src/Zexoro.Cli/Toolsets/BundledUpdaters.cs reads them. The list of runtime identifiers is the
    same as Zexoro.Platforms.UpdaterRuntime.All.
  -->
  <PropertyGroup>
    <ZexoroUpdaterRequired Condition="'$(ZexoroUpdaterRequired)' == ''">false</ZexoroUpdaterRequired>
  </PropertyGroup>

  <ItemGroup>
    <ZexoroUpdaterRid Include="win-x86" UpdaterFile="zexoro-updater-win-x86.exe" />
    <ZexoroUpdaterRid Include="win-x64" UpdaterFile="zexoro-updater-win-x64.exe" />
    <ZexoroUpdaterRid Include="win-arm64" UpdaterFile="zexoro-updater-win-arm64.exe" />
    <ZexoroUpdaterRid Include="linux-x64" UpdaterFile="zexoro-updater-linux-x64" />
    <ZexoroUpdaterRid Include="linux-arm64" UpdaterFile="zexoro-updater-linux-arm64" />
    <ZexoroUpdaterRid Include="linux-musl-x64" UpdaterFile="zexoro-updater-linux-musl-x64" />
    <ZexoroUpdaterRid Include="linux-musl-arm64" UpdaterFile="zexoro-updater-linux-musl-arm64" />
    <ZexoroUpdaterRid Include="osx-x64" UpdaterFile="zexoro-updater-osx-x64" />
    <ZexoroUpdaterRid Include="osx-arm64" UpdaterFile="zexoro-updater-osx-arm64" />
  </ItemGroup>

  <!-- gzip with the BCL; GZipStream writes no file name or time, so the output is reproducible. -->
  <UsingTask TaskName="ZexoroGzipFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!File.Exists(Destination) || File.GetLastWriteTimeUtc(Destination) < File.GetLastWriteTimeUtc(Source))
        {
            Directory.CreateDirectory(Path.GetDirectoryName(Destination));
            var temporary = Destination + ".tmp";
            using (var input = File.OpenRead(Source))
            using (var output = File.Create(temporary))
            using (var gzip = new GZipStream(output, CompressionLevel.Optimal))
            {
                input.CopyTo(gzip);
            }

            File.Copy(temporary, Destination, true);
            File.Delete(temporary);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ZexoroEmbedUpdaters" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ZexoroUpdaterDir)' == '' and '$(ZexoroUpdaterRequired)' == 'true'"
           Text="ZexoroUpdaterRequired is true, but ZexoroUpdaterDir is not set; publish src/Zexoro.Updater for @(ZexoroUpdaterRid, ', ') and pass -p:ZexoroUpdaterDir=&lt;dir&gt;." />
    <Message Condition="'$(ZexoroUpdaterDir)' == ''" Importance="high"
             Text="zexoro: building without embedded updaters (no ZexoroUpdaterDir); 'zexoro pack' with [updates] then needs ZEXORO_UPDATER_DIR." />

    <PropertyGroup Condition="'$(ZexoroUpdaterDir)' != ''">
      <!-- A relative directory is taken from where the build was started. -->
      <_ZexoroUpdaterDir>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildStartupDirectory)', '$(ZexoroUpdaterDir)'))))</_ZexoroUpdaterDir>
      <_ZexoroUpdaterSums>$([System.IO.Path]::Combine('$(_ZexoroUpdaterDir)', 'SHA256SUMS'))</_ZexoroUpdaterSums>
      <_ZexoroUpdaterGzipDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)zexoro-updaters'))</_ZexoroUpdaterGzipDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(ZexoroUpdaterDir)' != ''">
      <_ZexoroUpdater Include="@(ZexoroUpdaterRid->'$(_ZexoroUpdaterDir)/%(UpdaterFile)')" Rid="%(Identity)" UpdaterFile="%(UpdaterFile)" />
    </ItemGroup>

    <Error Condition="'$(ZexoroUpdaterDir)' != '' and !Exists('%(_ZexoroUpdater.FullPath)')"
           Text="ZexoroUpdaterDir: %(_ZexoroUpdater.FullPath) does not exist; the directory needs @(ZexoroUpdaterRid->'%(UpdaterFile)', ', ')." />

    <GetFileHash Condition="'$(ZexoroUpdaterDir)' != ''" Files="@(_ZexoroUpdater)" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Items" ItemName="_ZexoroUpdaterHashed" />
    </GetFileHash>

    <ItemGroup Condition="'$(ZexoroUpdaterDir)' != ''">
      <_ZexoroUpdaterHashed>
        <Sha256>$([System.String]::Copy('%(FileHash)').ToLowerInvariant())</Sha256>
        <Gzip>$(_ZexoroUpdaterGzipDir)/%(Rid).gz</Gzip>
      </_ZexoroUpdaterHashed>
    </ItemGroup>

    <ReadLinesFromFile Condition="'$(ZexoroUpdaterDir)' != '' and Exists('$(_ZexoroUpdaterSums)')" File="$(_ZexoroUpdaterSums)">
      <Output TaskParameter="Lines" ItemName="_ZexoroUpdaterSumLines" />
    </ReadLinesFromFile>
    <PropertyGroup Condition="'$(ZexoroUpdaterDir)' != ''">
      <!-- sha256sum writes "<hash>  <file>", or "<hash> *<file>" in binary mode. -->
      <_ZexoroUpdaterSumText>;@(_ZexoroUpdaterSumLines->Replace('*', ' ')->ToLowerInvariant());</_ZexoroUpdaterSumText>
    </PropertyGroup>
    <Error Condition="'$(ZexoroUpdaterDir)' != '' and Exists('$(_ZexoroUpdaterSums)') and !$(_ZexoroUpdaterSumText.Contains(';%(_ZexoroUpdaterHashed.Sha256)  %(_ZexoroUpdaterHashed.UpdaterFile);'))"
           Text="%(_ZexoroUpdaterHashed.FullPath) (SHA-256 %(_ZexoroUpdaterHashed.Sha256)) does not match $(_ZexoroUpdaterSums)." />

    <ZexoroGzipFile Condition="'$(ZexoroUpdaterDir)' != ''" Source="%(_ZexoroUpdaterHashed.FullPath)" Destination="%(_ZexoroUpdaterHashed.Gzip)" />

    <ItemGroup Condition="'$(ZexoroUpdaterDir)' != ''">
      <EmbeddedResource Include="@(_ZexoroUpdaterHashed->'%(Gzip)')" LogicalName="Zexoro.Updater.%(_ZexoroUpdaterHashed.Rid).gz" WithCulture="false" Type="Non-Resx" />
      <AssemblyMetadata Include="Zexoro.Updater.%(_ZexoroUpdaterHashed.Rid).Sha256" Value="%(_ZexoroUpdaterHashed.Sha256)" />
    </ItemGroup>
  </Target>
</Project>
