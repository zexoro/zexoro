       System.Formats.Tar, and what deb, rpm and apk will share (.desktop files, PNG icons). -->
  <PropertyGroup>
    <RootNamespace>Zexoro.Formats.Linux</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zexoro.Core\Zexoro.Core.csproj" />
    <ProjectReference Include="..\Zexoro.Formats.Nsis\Zexoro.Formats.Nsis.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Zexoro.Formats.Linux.Tests" />
  </ItemGroup>
</Project>
