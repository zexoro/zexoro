<Project Sdk="Microsoft.NET.Sdk">
  <!--
    zexoro-updater: the updater shipped inside every install (docs/design/0005-nsis-updates.md
    section 3, 0006-desktop-formats.md section 2). Published with Native AOT for win-x86, win-x64,
    win-arm64, linux-x64, linux-arm64, linux-musl-x64, linux-musl-arm64, osx-x64 and osx-arm64
    (eng/updater/); it builds and its tests run on every host, with the Windows-only pieces behind
    small interfaces. app.manifest only matters on Windows.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>zexoro-updater</AssemblyName>
    <RootNamespace>Zexoro.Updater</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- asInvoker: the updater never elevates, and its name must not trigger installer detection. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OptimizationPreference>Size</OptimizationPreference>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zexoro.Core\Zexoro.Core.csproj" />
    <ProjectReference Include="..\Zexoro.Updates\Zexoro.Updates.csproj" />
    <ProjectReference Include="..\Zexoro.Formats.Nsis\Zexoro.Formats.Nsis.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Zexoro.Updater.Tests" />
  </ItemGroup>
</Project>
